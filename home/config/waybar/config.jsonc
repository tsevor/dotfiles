{
	// STATUS PALETTE
	// #777777;
	// #cc77cc;
	// #b093cc;
	// #93b0cc;
	// #77cccc;
	// #7777cc;
	// #cc77cc;
	// #cccccc;

	"layer": "top",
	"position": "top",
	"height": 38,

	// MODULES

	"modules-left": [
		"custom/archlogo",
		"clock",
		"hyprland/workspaces"
	],

	"modules-center": [
		"hyprland/window"
	],

	"modules-right": [
		"tray",
		"cpu",
		"memory",
		"temperature",
		"bluetooth",
		"network",
		"pulseaudio",
		"backlight",
		"battery"
	],

	// LEFT

	"custom/archlogo": {
		"format": "<span color='#77cccc'>󰣇</span>",
		"tooltip": false,
		"on-click": "pkill wofi || wofi"
	},

	"clock": {
		"interval": 1,
		"format": "{:%Y-%m-%d %I:%M:%S}",
		"tooltip-format": "{calendar}"
	},

	"hyprland/workspaces": {
		"disable-scroll": true,
		"all-outputs": true,
		"format": "{name}"
	},

	// CENTER

	"hyprland/window": {
		"format": "{title}",
		"icon": true,
		"icon-size": 13,
		"max-length": 55
	},

	// RIGHT

	"cpu": {
		"interval": 1,
		"format": "{icon}",
		"format-icons": [
			"<span color='#77cccc'>󰝦</span>",
			"<span color='#77cccc'>󰪞</span>",
			"<span color='#77cccc'>󰪟</span>",
			"<span color='#93b0cc'>󰪠</span>",
			"<span color='#93b0cc'>󰪡</span>",
			"<span color='#b093cc'>󰪢</span>",
			"<span color='#b093cc'>󰪣</span>",
			"<span color='#cc77cc'>󰪤</span>",
			"<span color='#cc77cc'>󰪥</span>"
		]
	},

	"memory": {
		"interval": 1,
		"format": "{icon}",
		"format-icons": [
			"<span color='#77cccc'>󰝦</span>",
			"<span color='#77cccc'>󰪞</span>",
			"<span color='#77cccc'>󰪟</span>",
			"<span color='#93b0cc'>󰪠</span>",
			"<span color='#93b0cc'>󰪡</span>",
			"<span color='#b093cc'>󰪢</span>",
			"<span color='#b093cc'>󰪣</span>",
			"<span color='#cc77cc'>󰪤</span>",
			"<span color='#cc77cc'>󰪥</span>"
		]
	},

	"temperature": {
		"interval": 1,
		"format": "{icon}",
		"format-icons": [
			"<span color='#77cccc'>󰝦</span>",
			"<span color='#77cccc'>󰝦</span>",
			"<span color='#77cccc'>󰝦</span>",
			"<span color='#77cccc'>󰝦</span>",
			"<span color='#77cccc'>󰝦</span>",
			"<span color='#77cccc'>󰝦</span>",
			"<span color='#77cccc'>󰪞</span>",
			"<span color='#77cccc'>󰪟</span>",
			"<span color='#93b0cc'>󰪠</span>",
			"<span color='#93b0cc'>󰪡</span>",
			"<span color='#b093cc'>󰪢</span>",
			"<span color='#b093cc'>󰪣</span>",
			"<span color='#cc77cc'>󰪤</span>",
			"<span color='#cc77cc'>󰪥</span>"
		]
	},

	"bluetooth": {
		"format": "<span color='#777777'>󰂯</span>",
		"format-disabled": "<span color='#777777'>󰂲</span>",
		"format-occ": "<span color='#777777'>󰂲</span>",
		"format-on": "<span color='#777777'>󰂯</span>",
		"format-connected": "<span color='#77cccc'>󰂰</span>",
		"tooltip-format-connected": "{controller_alias}\t{controller_address}\n{device_alias}",
		"format-connected-battery": "{icon}",
		"tooltip-format-connected-battery": "{controller_alias}\t{controller_address}\n{device_alias}\t{device_battery_percentage}",
		"tooltip-format": "{controller_alias}\t{controller_address}",
		"format-no-controller": "",
		"on-click": "blueman-manager",
		"format-icons": [
			"<span color='#cc77cc'>󰥇</span>",
			"<span color='#cc77cc'>󰤾</span>",
			"<span color='#b093cc'>󰤿</span>",
			"<span color='#b093cc'>󰥀</span>",
			"<span color='#93b0cc'>󰥁</span>",
			"<span color='#93b0cc'>󰥂</span>",
			"<span color='#93b0cc'>󰥃</span>",
			"<span color='#77cccc'>󰥄</span>",
			"<span color='#77cccc'>󰥅</span>",
			"<span color='#77cccc'>󰥆</span>",
			"<span color='#77cccc'>󰥈</span>"
		]
	},

	"network": {
		"format-wifi": "{icon}",
		"format-ethernet": "<span color='#77cc77'>󰈀</span>",
		"format-disconnected": "<span color='#777777'>󰤮</span>",
		"tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
		"tooltip-format-ethernet": "IP: {ipaddr}",
		"format-icons": [
			"<span color='#cc77cc'>󰤯</span>",
			"<span color='#b093cc'>󰤟</span>",
			"<span color='#93b0cc'>󰤢</span>",
			"<span color='#77cccc'>󰤥</span>",
			"<span color='#77cccc'>󰤨</span>"
		]
	},

	"pulseaudio": {
		"format": "{icon}",
		"tooltip-format": "Volume: {volume}%\n{desc}",
		"format-muted": "<span color='#777777'>󰝟</span>",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
		"scroll-step": 5,
		"format-icons": [
			"<span color='#77cccc'>󰕿</span>",
			"<span color='#77cccc'>󰖀</span>",
			"<span color='#93b0cc'>󰕾</span>",
			"<span color='#b093cc'>󰕾</span>",
			"<span color='#cc77cc'>󰕾</span>"
		]
	},

	"backlight": {
		"format": "{icon}",
		"tooltip-format": "Brightness: {percent}%",
		"format-icons": [
			"<span color='#77cccc'>󰃞</span>",
			"<span color='#93b0cc'>󰃟</span>",
			"<span color='#b093cc'>󰃟</span>",
			"<span color='#b093cc'>󰃠</span>",
			"<span color='#cc77cc'>󰃠</span>",
			"<span color='#cc77cc'>󰃠</span>"
		]
	},

	"battery": {
		"format": "{icon}",
		"format-charging": "{icon}",
		"format-plugged": "<span color='#77cc77'>󰚥</span>",
		"tooltip-format": "Charge: {capacity}%\n{time} remaining",
		"format-icons": {
			"default": [
				"<span color='#cc77cc'>󰂎</span>",
				"<span color='#cc77cc'>󰁺</span>",
				"<span color='#cc77cc'>󰁻</span>",
				"<span color='#b093cc'>󰁼</span>",
				"<span color='#b093cc'>󰁽</span>",
				"<span color='#93b0cc'>󰁾</span>",
				"<span color='#93b0cc'>󰁿</span>",
				"<span color='#77cccc'>󰂀</span>",
				"<span color='#77cccc'>󰂁</span>",
				"<span color='#77cccc'>󰂂</span>",
				"<span color='#77cccc'>󰁹</span>"
			],
			"charging": [
				"<span color='#cc77cc'>󰢟</span>",
				"<span color='#cc77cc'>󰢜</span>",
				"<span color='#cc77cc'>󰂆</span>",
				"<span color='#b093cc'>󰂇</span>",
				"<span color='#b093cc'>󰂈</span>",
				"<span color='#93b0cc'>󰢝</span>",
				"<span color='#93b0cc'>󰂉</span>",
				"<span color='#77cccc'>󰢞</span>",
				"<span color='#77cccc'>󰂊</span>",
				"<span color='#77cccc'>󰂋</span>",
				"<span color='#77cccc'>󰂅</span>"
			]
		},
	},

	"tray": {
		"icon-size": 13,
		"spacing": 10
	}
}
