{
	"layer": "top",
	"position": "top",
	"height": 38,

	// MODULES

	"modules-left": [
		"custom/archlogo",
		"clock",
		"hyprland/workspaces"
	],

	"modules-center": [
		"hyprland/window"
	],

	"modules-right": [
		"tray",
		"cpu",
		"memory",
		"temperature",
		"bluetooth",
		"network",
		"pulseaudio",
		"backlight",
		"battery"
	],

	// LEFT

	"custom/archlogo": {
		"format": "<span color='#1793d1'>󰣇</span>",
		"tooltip": false,
		"on-click": "pkill wofi || wofi"
	},

	"clock": {
		"interval": 1,
		"format": "{:%Y-%m-%d %I:%M:%S}",
		"tooltip-format": "{calendar}"
	},

	"hyprland/workspaces": {
		"disable-scroll": true,
		"all-outputs": true,
		"format": "{name}"
	},

	// CENTER

	"hyprland/window": {
		"format": "{title}",
		"icon": true,
		"icon-size": 13,
		"max-length": 55
	},

	// RIGHT

	"cpu": {
		"interval": 1,
		"format": "{icon}",
		"format-icons": [
			"<span color='#77cc77'>󰝦</span>",
			"<span color='#8ccc77'>󰪞</span>",
			"<span color='#a2cc77'>󰪟</span>",
			"<span color='#b7cc77'>󰪠</span>",
			"<span color='#cccc77'>󰪡</span>",
			"<span color='#ccb777'>󰪢</span>",
			"<span color='#cca277'>󰪣</span>",
			"<span color='#cc8c77'>󰪤</span>",
			"<span color='#cc7777'>󰪥</span>"
		]
	},

	"memory": {
		"interval": 1,
		"format": "{icon}",
		"format-icons": [
			"<span color='#77cc77'>󰝦</span>",
			"<span color='#8ccc77'>󰪞</span>",
			"<span color='#a2cc77'>󰪟</span>",
			"<span color='#b7cc77'>󰪠</span>",
			"<span color='#cccc77'>󰪡</span>",
			"<span color='#ccb777'>󰪢</span>",
			"<span color='#cca277'>󰪣</span>",
			"<span color='#cc8c77'>󰪤</span>",
			"<span color='#cc7777'>󰪥</span>"
		]
	},

	"temperature": {
		"interval": 1,
		"format": "{icon}",
		"format-icons": [
			"<span color='#77cc77'>󰝦</span>",
			"<span color='#77cc77'>󰝦</span>",
			"<span color='#77cc77'>󰝦</span>",
			"<span color='#77cc77'>󰝦</span>",
			"<span color='#77cc77'>󰝦</span>",
			"<span color='#77cc77'>󰝦</span>",
			"<span color='#8ccc77'>󰪞</span>",
			"<span color='#a2cc77'>󰪟</span>",
			"<span color='#b7cc77'>󰪠</span>",
			"<span color='#cccc77'>󰪡</span>",
			"<span color='#ccb777'>󰪢</span>",
			"<span color='#cca277'>󰪣</span>",
			"<span color='#cc8c77'>󰪤</span>",
			"<span color='#cc7777'>󰪥</span>"
		]
	},

	"bluetooth": {
		"format": "<span color='#777777'>󰂯</span>",
		"format-disabled": "<span color='#777777'>󰂲</span>",
		"format-occ": "<span color='#777777'>󰂲</span>",
		"format-on": "<span color='#777777'>󰂯</span>",
		"format-connected": "<span color='#77cccc'>󰂰</span>",
		"tooltip-format-connected": "{controller_alias}\t{controller_address}\n{device_alias}",
		"format-connected-battery": "{icon}",
		"tooltip-format-connected-battery": "{controller_alias}\t{controller_address}\n{device_alias}\t{device_battery_percentage}",
		"tooltip-format": "{controller_alias}\t{controller_address}",
		"format-no-controller": "",
		"on-click": "blueman-manager",
		"format-icons": [
			"<span color='#cc7777'>󰥇</span>",
			"<span color='#cc8877'>󰤾</span>",
			"<span color='#cc9977'>󰤿</span>",
			"<span color='#ccaa77'>󰥀</span>",
			"<span color='#ccbb77'>󰥁</span>",
			"<span color='#cccc77'>󰥂</span>",
			"<span color='#bbcc77'>󰥃</span>",
			"<span color='#aacc77'>󰥄</span>",
			"<span color='#99cc77'>󰥅</span>",
			"<span color='#88cc77'>󰥆</span>",
			"<span color='#77cc77'>󰥈</span>"
		]
	},

	"network": {
		"format-wifi": "{icon}",
		"format-ethernet": "<span color='#77cc77'>󰈀</span>",
		"format-disconnected": "<span color='#777777'>󰤮</span>",
		"tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
		"tooltip-format-ethernet": "IP: {ipaddr}",
		"format-icons": [
			"<span color='#cc7777'>󰤯</span>",
			"<span color='#cc8f77'>󰤟</span>",
			"<span color='#cca877'>󰤟</span>",
			"<span color='#ccc077'>󰤢</span>",
			"<span color='#c0cc77'>󰤢</span>",
			"<span color='#a8cc77'>󰤥</span>",
			"<span color='#8fcc77'>󰤥</span>",
			"<span color='#77cc77'>󰤨</span>"
		]
	},

	"pulseaudio": {
		"format": "{icon}",
		"tooltip-format": "Volume: {volume}%\n{desc}",
		"format-muted": "<span color='#777777'>󰝟</span>",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
		"scroll-step": 5,
		"format-icons": [
			"<span color='#77cc77'>󰕿</span>",
			"<span color='#8acc77'>󰕿</span>",
			"<span color='#9dcc77'>󰕿</span>",
			"<span color='#b0cc77'>󰖀</span>",
			"<span color='#c3cc77'>󰖀</span>",
			"<span color='#ccc377'>󰖀</span>",
			"<span color='#ccb077'>󰕾</span>",
			"<span color='#cc9d77'>󰕾</span>",
			"<span color='#cc8a77'>󰕾</span>",
			"<span color='#cc7777'>󰕾</span>"
		]
	},

	"backlight": {
		"format": "{icon}",
		"tooltip-format": "Brightness: {percent}%",
		"format-icons": [
			"<span color='#77cc77'>󰃞</span>",
			"<span color='#8acc77'>󰃟</span>",
			"<span color='#9dcc77'>󰃟</span>",
			"<span color='#b0cc77'>󰃟</span>",
			"<span color='#c3cc77'>󰃠</span>",
			"<span color='#ccc377'>󰃠</span>",
			"<span color='#ccb077'>󰃠</span>",
			"<span color='#cc9d77'>󰃠</span>",
			"<span color='#cc8a77'>󰃠</span>",
			"<span color='#cc7777'>󰃠</span>"
		]
	},

	"battery": {
		"format": "{icon}",
		"format-charging": "{icon}",
		"format-plugged": "<span color='#77cc77'>󰚥</span>",
		"tooltip-format": "Charge: {capacity}%\n{time} remaining",
		"format-icons": {
			"default": [
				"<span color='#cc7777'>󰂎</span>",
				"<span color='#cc8877'>󰁺</span>",
				"<span color='#cc9977'>󰁻</span>",
				"<span color='#ccaa77'>󰁼</span>",
				"<span color='#ccbb77'>󰁽</span>",
				"<span color='#cccc77'>󰁾</span>",
				"<span color='#bbcc77'>󰁿</span>",
				"<span color='#aacc77'>󰂀</span>",
				"<span color='#99cc77'>󰂁</span>",
				"<span color='#88cc77'>󰂂</span>",
				"<span color='#77cc77'>󰁹</span>"
			],
			"charging": [
				"<span color='#cc7777'>󰢟</span>",
				"<span color='#cc8877'>󰢜</span>",
				"<span color='#cc9977'>󰂆</span>",
				"<span color='#ccaa77'>󰂇</span>",
				"<span color='#ccbb77'>󰂈</span>",
				"<span color='#cccc77'>󰢝</span>",
				"<span color='#bbcc77'>󰂉</span>",
				"<span color='#aacc77'>󰢞</span>",
				"<span color='#99cc77'>󰂊</span>",
				"<span color='#88cc77'>󰂋</span>",
				"<span color='#77cc77'>󰂅</span>"
			]
		},
	},

	"tray": {
		"icon-size": 13,
		"spacing": 16
	}
}
