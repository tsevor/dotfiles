{
	"layer": "top",
	"position": "top",
	"height": 20,

	// MODULES

	"modules-left": [
		"custom/archlogo",
		"clock",
		"hyprland/workspaces"
	],

	"modules-center": [
		"wlr/taskbar"
	],

	"modules-right": [
		"cpu",
		"memory",
		"temperature",
		"network",
		"bluetooth",
		"backlight",
		"pulseaudio",
		"battery",
		"tray"
	],

	// LEFT

	"custom/archlogo": {
		"format": "<span color='#1793d1'>󰣇</span>",
		"tooltip": false
	},

	"clock": {
		"interval": 1,
		"format": "{:%Y-%m-%d %I:%M:%S}",
		"tooltip-format": "{calendar}"
	},

	"hyprland/workspaces": {
		"disable-scroll": true,
		"all-outputs": true,
		"format": "{name}",
	},

	// CENTER

	"wlr/taskbar": {
		"format": "{icon} {title:.32}",
		"icon-size": 15,
		"spacing": 3,
		"on-click-middle": "close",
		"tooltip-format": "{title}",
		"ignore-list": [],
		"on-click": "activate"
	},

	// RIGHT

	"cpu": {
		"interval": 2,
		"states": { "warning": 50, "critical": 80 },
		"format": "<span color='#cccccc'>cpu:</span>{usage}%"
	},

	"memory": {
		"interval": 2,
		"states": { "warning": 50, "critical": 80 },
		"format": "<span color='#cccccc'>mem:</span>{used:0.1f}g"
	},

	"temperature": {
		"critical-threshold": 80,
		"format": "<span color='#cccccc'>tmp:</span>{temperatureC}°C",
		"format-critical": "<span color='#cccccc'>tmp:</span>{temperatureC}°C"
	},

	"network": {
		"format-wifi": "<span color='#cccccc'>wifi:</span>{icon}{signalStrength}%</span>",
		"format-ethernet": "<span color='#77cccc'>eth</span>",
		"format-disconnected": "<span color='#cc7777'>dis</span>",
		"tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
		"tooltip-format-ethernet": "IP: {ipaddr}",
		"format-icons": [
			"<span color='#cc7777'>", "<span color='#cc7777'>",
			"<span color='#ccb377'>", "<span color='#cccc77'>",
			"<span color='#cccc77'>", "<span color='#77cc77'>",
			"<span color='#77cc77'>", "<span color='#77cc77'>",
			"<span color='#77cc77'>", "<span color='#77cc77'>"
		]
	},

	"bluetooth": {
		"format": "<span color='#cccccc'>bt:</span><span color='#77cccc'>{status}</span>",
		"format-disabled": "<span color='#cccccc'>bt:</span><span color='#cc7777'>occ</span>",
		"format-occ": "<span color='#cccccc'>bt:</span><span color='#cc7777'>occ</span>",
		"format-on": "<span color='#cccccc'>bt:</span><span color='#77cc77'>on</span>",
		"format-connected": "<span color='#cccccc'>bt:</span><span color='#77cc77'>{device_alias}</span>",
		"format-connected-battery": "<span color='#cccccc'>bt:</span><span color='#77cc77'>{device_alias} {device_battery_percentage}%</span>",
		"tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
		"format-no-controller": "",
		"on-click": "blueman-manager"
	},

	"backlight": {
		"format": "<span color='#cccccc'>brt:</span>{icon}{percent}%</span>",
		"tooltip-format": "Brightness: {percent}%",
		"format-icons": [
			"<span color='#77cc77'>", "<span color='#77cc77'>", "<span color='#77cc77'>", "<span color='#77cc77'>",
			"<span color='#cccc77'>", "<span color='#cccc77'>",
			"<span color='#ccb377'>", "<span color='#ccb377'>",
			"<span color='#cc7777'>", "<span color='#cc7777'>"
		]
	},

	"pulseaudio": {
		"format": "<span color='#cccccc'>vol:</span>{icon}{volume}%</span>",
		"format-muted": "<span color='#cccccc'>vol:</span><span color='#cc77cc'>{volume}%</span>",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
		"scroll-step": 5,
		"format-icons": [
			"<span color='#77cc77'>", "<span color='#77cc77'>",
			"<span color='#cccc77'>", "<span color='#cccc77'>",
			"<span color='#ccb377'>", "<span color='#ccb377'>",
			"<span color='#cc7777'>", "<span color='#cc7777'>"
		]
	},

	"battery": {
		"states": { "good": 95, "warning": 30, "critical": 15 },
		"format": "<span color='#cccccc'>bat:</span>{capacity}%",
		"format-charging": "<span color='#cccccc'>bat:</span>{capacity}%",
		"format-plugged": "<span color='#cccccc'>bat:</span>{capacity}%"
	},

	"tray": {
		"icon-size": 13,
		"spacing": 10
	}
}
