color-link default "#acb2be"
color-link comment "#c4ab92"

color-link identifier "#85ffeb"
color-link identifier.class "#8a9cff"
color-link identifier.var "#85ffeb"
color-link identifier.macro "#b65252"

color-link constant "#66abd9"
color-link constant.number "#ffffff"
color-link constant.string "#c4ff8d"
color-link constant.specialChar "#ff8b55"

color-link statement "#ff8fcd"
color-link preproc "#b65252"
color-link type "#34c58d"
color-link type.keyword "#ff8fcd"
color-link special "#79d3f1"

color-link symbol "#ffffff"
color-link symbol.operator "#ffffff"
color-link symbol.brackets "#ffffff"
color-link symbol.tag "#43eea1"

color-link underlined "underline #7ccc84"
color-link error "#d07277"
color-link todo "bold #dec184"

color-link selection ",#363c46"
color-link statusline "#dce0e5,#1f1f1f"
color-link statusline.inactive "#a9afbc,#2e343e"
color-link statusline.suggestions "#dce0e5,#2e343e"
color-link tabbar "#a9afbc,#141414"
color-link tabbar.active "#dce0e5,#0a0a0a"
color-link indent-char "#878a98"
color-link line-number "#4e5a5f"
color-link current-line-number "#d0d4da"

color-link color-column ",#141414"
color-link match-brace ",#74ade8"
color-link hlsearch "#0a0a0a,#e8af74"
color-link divider "#464b57,#1f1f1f"
color-link scrollbar ",#363c46"

color-link diff-added "#a1c181"
color-link diff-modified "#dec184"
color-link diff-deleted "#d07277"
color-link gutter-error "#d07277"
color-link gutter-warning "#dec184"
color-link gutter-info "#74ade8"
color-link message "#dce0e5"
color-link error-message "#d07277"
