# Global settings
font=monospace 12
background-color=#000000CC
text-color=#cccccc
width=450
margin=16
padding=8
border-size=0
border-radius=10
default-timeout=5000

# High urgency notifications (matches #cpu.critical / #battery.critical)
[urgency=high]
	text-color=#cc7777
	border-size=2
	border-color=#cc7777CC
	default-timeout=0

# Low urgency notifications
[urgency=low]
	text-color=#cccccc

# Actionable/button formatting
[mode=do-not-disturb]
	invisible=1
